# Copia para .env e preenche

# Cria uma chave grátis em https://the-odds-api.com (free tier: 500
# pedidos/mês). Sem chave, usa `--json data/exemplo_odds.json` no CLI.
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Desportos a verificar em `live`/`resumo` (chaves da The Odds API,
# separadas por vírgula). Usa `python main.py desportos --filtro texto`
# para encontrares/confirmares chaves (ex: --filtro portugal, --filtro
# basket) — lista completa também em
# https://the-odds-api.com/sports-odds-data/sports-apis.html
#
# ⚠️ Não uses "todas as competições": o free tier da The Odds API é 500
# pedidos/mês, e cada competição aqui = 1 pedido por verificação. Esta
# lista (8 competições) usada 1x/dia com `resumo` fica bem dentro do
# limite (~240/mês); em `live` (contínuo) reduz a lista ou aumenta
# INTERVALO_VERIFICACAO_SEGUNDOS bastante para não estourares o limite.
DESPORTOS=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_portugal_primeira_liga,soccer_uefa_champs_league,soccer_uefa_nations_league,basketball_nba
REGIOES=eu
MERCADOS=h2h

# Modelo estatístico próprio (golos marcados/sofridos — ver comando
# `modelo`). Cria uma chave grátis em
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
MODELO_JOGOS_HISTORICO=200
MODELO_MARGEM_MINIMA=0.05

# Competições de `modelo --todas` (código football-data.org:chave The Odds
# API, separados por vírgula). Usa `python main.py competicoes` e
# `desportos --filtro <termo>` para confirmares mais pares antes de
# adicionares — o valor por omissão (em config.py) já cobre as 11
# competições de clubes do free tier da football-data.org.
# COMPETICOES_MODELO=PL:soccer_epl,PD:soccer_spain_la_liga,...

MARGEM_MINIMA_ARBITRAGEM=0.01
MARGEM_MINIMA_VALOR=0.03

# Ignora apostas de valor em odds acima disto (0 desativa o limite). Odds
# muito altas (azarões) dão "valor" mais ruidoso e sofrem mais do
# "favorite-longshot bias" — ver README.
ODD_MAXIMA_VALOR=4.0

# Nomes de bookmakers a considerar (como aparecem na The Odds API, separados
# por vírgula), ex: Betfair,Betano,Bwin. Vazio = todas. Usa isto para
# excluir casas não licenciadas na tua jurisdição ou pouco fiáveis.
BOOKMAKERS_FIAVEIS=

CAPITAL_INICIAL=100
STAKE_MAXIMA_POR_APOSTA=10
FRACAO_KELLY=0.25

# ⚠️ Mantém EXECUCAO_AUTOMATICA=false e MODO_PAPER=true até teres validado
# bem a estratégia. Mesmo com ambos ligados, só apostas identificadas como
# "Betfair" são executadas de facto — ver README.
EXECUCAO_AUTOMATICA=false
MODO_PAPER=true

# Só necessário para execução real na Betfair Exchange (ver README, secção
# "Execução automática (Betfair Exchange)").
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERTS_DIR=

INTERVALO_VERIFICACAO_SEGUNDOS=300

# Cria um bot com o @BotFather no Telegram e envia-lhe uma mensagem para
# obteres o CHAT_ID em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
